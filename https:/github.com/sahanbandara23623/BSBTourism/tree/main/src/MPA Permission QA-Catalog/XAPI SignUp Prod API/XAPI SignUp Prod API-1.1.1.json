{
  "openapi": "3.1.0",
  "info": {
    "title": "Header Object Test API",
    "version": "1.0.0"
  },
  "paths": {
    "/products": {
      "get": {
        "summary": "List products - basic header with schema",
        "responses": {
          "200": {
            "description": "List of products",
            "headers": {
              "X-Rate-Limit": {
                "description": "The number of allowed requests in the current period",
                "required": true,
                "schema": {
                  "type": "integer"
                }
              },
              "X-Request-Id": {
                "description": "Unique identifier for the request",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Product"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/products/{id}": {
      "get": {
        "summary": "Get product - deprecated header and example",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Product found",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          }
        }
      }
    },
    "/orders": {
      "post": {
        "summary": "Create order - header via $ref to components",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrder"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order created",
            "headers": {
              "Location": {
                "$ref": "#/components/headers/LocationHeader"
              },
              "X-Rate-Limit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          }
        }
      }
    },
    "/files/upload": {
      "post": {
        "summary": "Upload file - headers inside Encoding Object",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "metadata": {
                    "type": "object"
                  }
                }
              },
              "encoding": {
                "file": {
                  "contentType": "application/octet-stream",
                  "headers": {
                    "X-File-Checksum2": {
                      "description": "SHA-256 checksum of the uploaded file",
                      "required": true,
                      "schema": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "File uploaded"
          }
        }
      }
    },
    "/reports": {
      "get": {
        "summary": "Get report - content-based header (style not applicable)",
        "responses": {
          "200": {
            "description": "Report data",
            "headers": {
              "X-Report-Meta": {
                "description": "Structured metadata about the report, serialized as JSON",
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "properties": {
                        "generatedAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "rowCount": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Product": {
        "type": "object",
        "required": [
          "id",
          "name",
          "price"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "format": "float"
          },
          "category": {
            "type": "string"
          }
        }
      },
      "Order": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "CreateOrder": {
        "type": "object",
        "required": [
          "productId"
        ],
        "properties": {
          "productId": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          }
        }
      }
    },
    "headers": {
      "LocationHeader": {
        "description": "URL of the newly created resource",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uri"
        }
      },
      "RateLimitRemaining": {
        "description": "Number of requests remaining in the current rate limit window",
        "schema": {
          "type": "integer"
        },
        "style": "simple",
        "explode": false
      },
      "RateLimitRemaining2": {
        "description": "Number of requests remaining in the current rate limit window",
        "schema": {
          "type": "integer"
        },
        "style": "simple",
        "explode": false
      }
    }
  }
}