{
  "openapi": "3.1.0",
  "info": {
    "title": "Ticket Booking API",
    "version": "1.0.0",
    "description": "A RESTful CRUD API for managing ticket bookings."
  },
  "paths": {
    "/tickets": {
      "get": {
        "summary": "Retrieve all tickets",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "example": [
                  {
                    "id": 1,
                    "event": "Concert",
                    "date": "2023-10-15",
                    "quantity": 2,
                    "status": "Booked"
                  },
                  {
                    "id": 2,
                    "event": "Theater Play",
                    "date": "2023-11-05",
                    "quantity": 3,
                    "status": "Booked"
                  }
                ]
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new ticket booking",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "event": {
                    "type": "string"
                  },
                  "date": {
                    "type": "string",
                    "format": "date"
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                  }
                },
                "required": [
                  "event",
                  "date",
                  "quantity"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Ticket booking created successfully"
          },
          "400": {
            "description": "Invalid request payload"
          }
        }
      }
    },
    "/tickets/{id}": {
      "get": {
        "summary": "Retrieve a ticket booking by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID of the ticket booking",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "example": {
                  "id": 1,
                  "event": "Concert",
                  "date": "2023-10-15",
                  "quantity": 2,
                  "status": "Booked"
                }
              }
            }
          },
          "404": {
            "description": "Ticket booking not found"
          }
        }
      },
      "put": {
        "summary": "Update a ticket booking by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID of the ticket booking",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "event": {
                    "type": "string"
                  },
                  "date": {
                    "type": "string",
                    "format": "date"
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                  }
                },
                "required": [
                  "event",
                  "date",
                  "quantity"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ticket booking updated successfully"
          },
          "400": {
            "description": "Invalid request payload"
          },
          "404": {
            "description": "Ticket booking not found"
          }
        }
      },
      "delete": {
        "summary": "Delete a ticket booking by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID of the ticket booking",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Ticket booking deleted successfully"
          },
          "404": {
            "description": "Ticket booking not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Ticket": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "event": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "status": {
            "type": "string",
            "enum": [
              "Booked",
              "Cancelled"
            ]
          }
        }
      }
    }
  }
}